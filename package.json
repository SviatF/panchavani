    "audit:preindex": "node scripts/audit-first-indexing-readiness.mjs",
    "test:preindex": "node --test scripts/test-approved-day-value-gate.mjs scripts/test-reviewed-page-generation.mjs"
  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.43.0"
  },
  "engines": {
    "node": ">=20"
  }
}
